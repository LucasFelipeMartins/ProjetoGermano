{
  "version": 2,
  "builds": [
    { "src": "api/index.ts", "use": "@vercel/node", "config": { "includeFiles": "public/**" } },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/(css|js|assets)/(.*)$", "dest": "/public/$1/$2" },
    { "src": "/(.*)", "dest": "/api/index.ts" }
  ]
}
